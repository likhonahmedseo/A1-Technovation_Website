
RewriteOptions inherit
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://a1technovation.com/ [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ https://a1technovation.com/$1 [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^www\.a1technovation\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://a1technovation.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$ [NC]
  RewriteCond %{DOCUMENT_ROOT}%1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  RewriteRule ^(config|database|docs)/ - [F,L]
  RewriteRule ^tools/ - [F,L]
  RewriteRule ^php/cms/ - [F,L]
  RewriteRule ^php/(bootstrap|SmtpMailer)\.php$ - [F,L]
  RewriteRule ^cache/ - [F,L]
  RewriteRule ^404/?$ /404.html [L,QSA]
  RewriteRule ^pages/tools/?$ /pages/tools.html [L,QSA,NC]
  RewriteRule ^pages/seo-for-small-businesses/?$ /blog/seo-for-small-businesses/ [R=301,L,NC]
  RewriteRule ^aeo-optimization-services/?$ /pages/services-aeo-optimization.html [L,QSA,NC]
  RewriteRule ^geo-optimization-services/?$ /pages/services-geo-optimization.html [L,QSA,NC]
  RewriteRule ^ecommerce-seo-services/?$ /pages/ecommerce-seo-services.html [L,QSA,NC]
  RewriteRule ^car-dealership-seo-service-bangladesh/?$ /pages/car-dealership-seo-service-bangladesh.html [L,QSA,NC]
  RewriteRule ^seo-for-renovation-companies/?$ /pages/seo-for-renovation-companies.html [L,QSA,NC]
  RewriteRule ^seo-for-renovation-companies-toronto/?$ /pages/seo-for-renovation-companies-toronto.html [L,QSA,NC]
  RewriteRule ^best-seo-expert-in-bangladesh/?$ /pages/best-seo-expert-in-bangladesh.html [L,QSA,NC]
  RewriteRule ^pages/luxury-car-dealership-seo/?$ "/pages/Car Dealership SEO Case Study.html" [R=301,L,NC]
  RewriteRule ^case-studies/luxury-car-dealership-seo/?$ "/pages/Car Dealership SEO Case Study.html" [L,QSA,NC]
  RewriteRule ^case-studies/car-dealership-seo-case-study/?$ "/pages/Car Dealership SEO Case Study.html" [L,QSA,NC]
  RewriteRule ^pages/car-dealership-seo-case-study/?$ "/pages/Car Dealership SEO Case Study.html" [L,QSA,NC]
  RewriteRule ^blog/luxury-car-dealership-seo/?$ "/pages/Car Dealership SEO Case Study.html" [L,QSA,NC]
  RewriteRule ^blog/car-dealership-seo-case-study/?$ "/pages/Car Dealership SEO Case Study.html" [L,QSA,NC]
  RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
  RewriteRule ^(seo-services-[a-z-]+)/?$ /pages/$1.html [L,QSA,NC]
  # REST API
  RewriteRule ^api/?$ /api.php [L,QSA]
  RewriteRule ^api/(.+)$ /api.php?resource=$1 [L,QSA]

  # Newsletter confirmation & unsubscribe
  RewriteRule ^newsletter/confirm/?$ /newsletter-confirm.php [L,QSA]
  RewriteRule ^newsletter/unsubscribe/?$ /newsletter-unsubscribe.php [L,QSA]

  # Blog taxonomy archives
  RewriteRule ^blog/?$ /blog.php [L,QSA]
  RewriteRule ^blog/categories/?$ /blog-categories.php [L,QSA]
  RewriteRule ^blog/category/([^/]+)/?$ /blog-category.php?category=$1 [L,QSA]
  RewriteRule ^blog/tag/([^/]+)/?$ /blog-tag.php?tag=$1 [L,QSA]
  RewriteRule ^blog/([^/]+)/?$ /blog-post.php?slug=$1 [L,QSA]

  RewriteRule ^page/([^/]+)/?$ /public-page.php?slug=$1 [L,QSA]
  RewriteRule ^services/([^/]+)/?$ /public-page.php?slug=$1 [L,QSA]
  RewriteRule ^landing/([^/]+)/?$ /public-page.php?slug=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /404.html [R=302,L]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|README\.md|.*\.(bak|old|sql|ps1|sh|log))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
